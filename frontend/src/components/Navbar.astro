---
import logo from "../assets/logo.png";
---

<header class="w-full bg-[#f5f5f5] px-5 py-6">
  <nav class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-5 sm:flex-row">
    <!-- Logo -->
    <a href="/" class="flex items-center">
      <img src={logo.src} alt="Loop" class="h-10 w-auto" />
    </a>

    <!-- Links -->
    <div class="flex flex-wrap items-center justify-center gap-4 text-[10px] font-bold uppercase tracking-wide text-[#081c44] sm:gap-7">
      <!-- Visible cuando NO hay sesión -->
      <div id="navNoLogueado" class="hidden flex-wrap items-center justify-center gap-4 sm:gap-7">
        <a href="/profesores" class="hover:text-[#0047ff]">
          Materias
        </a>

        <a href="/registro-profe" class="hover:text-[#0047ff]">
          Dar clases
        </a>

        <a href="/profesores#acerca" class="hover:text-[#0047ff]">
          Acerca
        </a>

        <a
          href="/login"
          class="rounded-full bg-[#0047ff] px-5 py-2 text-[10px] font-bold uppercase text-white transition hover:bg-blue-700"
        >
          Log in
        </a>
      </div>

      <!-- Visible cuando SÍ hay sesión -->
      <div id="navLogueado" class="hidden flex-wrap items-center justify-center gap-4 sm:gap-6">
        <div class="flex items-center gap-2">
          <span class="flex h-6 w-6 items-center justify-center rounded-full bg-[#081c44] text-[9px] text-white">
            ∞
          </span>

          <span id="navTokens" class="text-sm font-extrabold text-[#081c44]">
            0
          </span>
        </div>

        <a href="/mensajes" class="hover:text-[#0047ff]">
          Mensajes
        </a>

        <a href="/profesores" class="hover:text-[#0047ff]">
          Materias
        </a>

        <a href="/registro-profe" class="hover:text-[#0047ff]">
          Dar clases
        </a>

        <a href="/profesores#acerca" class="hover:text-[#0047ff]">
          Acerca
        </a>

        <a
          href="/perfil"
          class="rounded-full bg-[#0047ff] px-5 py-2 text-[10px] font-bold uppercase text-white transition hover:bg-blue-700"
        >
          Perfil
        </a>

        <a
          href="/logout"
          class="rounded-full border border-[#0047ff] px-4 py-2 text-[10px] font-bold uppercase text-[#0047ff] transition hover:bg-[#0047ff] hover:text-white"
        >
          Salir
        </a>
      </div>
    </div>
  </nav>

  <script>
    const navNoLogueado = document.getElementById("navNoLogueado") as HTMLDivElement | null;
    const navLogueado = document.getElementById("navLogueado") as HTMLDivElement | null;
    const navTokens = document.getElementById("navTokens") as HTMLSpanElement | null;

    const token = localStorage.getItem("token");
    const usuarioGuardado = localStorage.getItem("usuario");

    if (token) {
      navNoLogueado?.classList.add("hidden");

      navLogueado?.classList.remove("hidden");
      navLogueado?.classList.add("flex");

      if (usuarioGuardado && navTokens) {
        const usuario = JSON.parse(usuarioGuardado);
        navTokens.textContent = usuario.tokens ?? "0";
      }
    } else {
      navLogueado?.classList.add("hidden");

      navNoLogueado?.classList.remove("hidden");
      navNoLogueado?.classList.add("flex");
    }
  </script>
</header>
