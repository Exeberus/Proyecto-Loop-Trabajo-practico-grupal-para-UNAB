---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Postulaciones | Loop">
  <main class="min-h-[calc(100vh-160px)] bg-[#f5f5f5] px-5 py-12">
    <section class="mx-auto max-w-6xl">
      <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.22em] text-[#0047ff]">
            Panel admin
          </p>
          <h1 class="mt-2 text-3xl font-extrabold text-[#0047ff] md:text-4xl">
            Postulaciones de profesores
          </h1>
          <p class="mt-2 max-w-2xl text-sm font-semibold text-slate-500">
            Revisa certificados, materias y horarios antes de hacer visible un perfil.
          </p>
        </div>

        <a
          href="/profesores"
          class="w-fit rounded-full border border-[#0047ff] px-5 py-2 text-[10px] font-bold uppercase text-[#0047ff] transition hover:bg-[#0047ff] hover:text-white"
        >
          Ver profesores
        </a>
      </div>

      <p id="mensajeAdmin" class="hidden rounded-2xl px-5 py-4 text-sm font-bold"></p>

      <section
        id="listaPostulaciones"
        class="mt-6 grid grid-cols-1 gap-5"
      >
      </section>
    </section>
  </main>

  <script>
    const API_URL = ["localhost", "127.0.0.1"].includes(window.location.hostname)
      ? "http://127.0.0.1:5000"
      : "https://loop-backend-b1g8.onrender.com";

    const listaPostulaciones = document.getElementById("listaPostulaciones") as HTMLElement | null;
    const mensajeAdmin = document.getElementById("mensajeAdmin") as HTMLParagraphElement | null;

    type Postulacion = {
      postulacionId: number;
      nombre: string;
      email: string;
      materias: string[];
      descripcion: string;
      disponibilidad: { dia: string; horarios: string[] }[];
      certificadoNombre: string;
      estado: string;
    };

    function mostrarMensaje(texto: string, tipo: "ok" | "error" | "info" = "info") {
      if (!mensajeAdmin) return;

      mensajeAdmin.textContent = texto;
      mensajeAdmin.classList.remove("hidden");

      const base = "rounded-2xl px-5 py-4 text-sm font-bold";
      if (tipo === "ok") mensajeAdmin.className = `${base} bg-green-50 text-green-700`;
      if (tipo === "error") mensajeAdmin.className = `${base} bg-red-50 text-red-600`;
      if (tipo === "info") mensajeAdmin.className = `${base} bg-blue-50 text-[#0047ff]`;
    }

    function estadoClase(estado: string) {
      if (estado === "aprobada") return "bg-green-100 text-green-700";
      if (estado === "rechazada") return "bg-red-100 text-red-600";
      return "bg-yellow-100 text-yellow-700";
    }

    function crearPostulacion(postulacion: Postulacion) {
      const article = document.createElement("article");
      article.className =
        "rounded-[24px] bg-white p-6 shadow-lg";

      const materias = postulacion.materias?.join(", ") || "Sin materia";
      const disponibilidad = postulacion.disponibilidad
        ?.map((bloque) => `${bloque.dia}: ${bloque.horarios.join(", ")}`)
        .join(" | ") || "Sin horarios";

      article.innerHTML = `
        <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
          <div class="max-w-3xl">
            <div class="mb-3 flex flex-wrap items-center gap-3">
              <span class="rounded-full px-4 py-2 text-[10px] font-bold uppercase ${estadoClase(postulacion.estado)}">
                ${postulacion.estado}
              </span>
              <span class="text-[10px] font-bold uppercase tracking-widest text-[#0047ff]">
                ${materias}
              </span>
            </div>

            <h2 class="text-2xl font-extrabold text-[#081c44]">
              ${postulacion.nombre}
            </h2>
            <p class="mt-1 break-all text-xs font-bold uppercase text-[#0047ff]">
              ${postulacion.email}
            </p>

            <p class="mt-4 text-sm font-semibold leading-relaxed text-slate-600">
              ${postulacion.descripcion || "Sin descripcion cargada."}
            </p>

            <div class="mt-5 grid grid-cols-1 gap-3 md:grid-cols-2">
              <div class="rounded-2xl bg-slate-50 p-4">
                <p class="text-[10px] font-bold uppercase tracking-widest text-[#0047ff]">
                  Disponibilidad
                </p>
                <p class="mt-2 text-sm font-bold text-[#081c44]">
                  ${disponibilidad}
                </p>
              </div>

              <div class="rounded-2xl bg-slate-50 p-4">
                <p class="text-[10px] font-bold uppercase tracking-widest text-[#0047ff]">
                  Certificado
                </p>
                <p class="mt-2 break-all text-sm font-bold text-[#081c44]">
                  ${postulacion.certificadoNombre || "Sin archivo"}
                </p>
              </div>
            </div>
          </div>

          <div class="flex shrink-0 flex-wrap gap-3 lg:flex-col">
            <button
              type="button"
              data-accion="aprobar"
              data-id="${postulacion.postulacionId}"
              class="rounded-full bg-[#0047ff] px-7 py-3 text-[10px] font-bold uppercase text-white shadow-md transition hover:bg-blue-700 disabled:opacity-50"
            >
              Aprobar
            </button>
            <button
              type="button"
              data-accion="rechazar"
              data-id="${postulacion.postulacionId}"
              class="rounded-full border border-red-500 px-7 py-3 text-[10px] font-bold uppercase text-red-500 transition hover:bg-red-500 hover:text-white disabled:opacity-50"
            >
              Rechazar
            </button>
          </div>
        </div>
      `;

      return article;
    }

    async function cambiarEstado(id: string, accion: "aprobar" | "rechazar") {
      const token = localStorage.getItem("token");
      if (!token) {
        window.location.href = "/login";
        return;
      }

      try {
        mostrarMensaje("Guardando cambio...", "info");

        const respuesta = await fetch(`${API_URL}/api/admin/postulaciones/${id}/${accion}`, {
          method: "PATCH",
          headers: {
            Authorization: `Bearer ${token}`,
          },
        });

        const data = await respuesta.json();

        if (!respuesta.ok) {
          mostrarMensaje(data.mensaje || "No se pudo actualizar la postulacion.", "error");
          return;
        }

        mostrarMensaje(data.mensaje || "Postulacion actualizada.", "ok");
        cargarPostulaciones();
      } catch (error) {
        mostrarMensaje("No se pudo conectar con el servidor.", "error");
      }
    }

    async function cargarPostulaciones() {
      const token = localStorage.getItem("token");
      const usuario = JSON.parse(localStorage.getItem("usuario") || "null");

      if (!token || usuario?.rol !== "admin") {
        mostrarMensaje("Necesitas iniciar sesion como administrador.", "error");
        listaPostulaciones?.replaceChildren();
        return;
      }

      try {
        const respuesta = await fetch(`${API_URL}/api/admin/postulaciones`, {
          headers: {
            Authorization: `Bearer ${token}`,
          },
        });

        const data = await respuesta.json();

        if (!respuesta.ok) {
          mostrarMensaje(data.mensaje || "No se pudieron cargar las postulaciones.", "error");
          return;
        }

        const postulaciones = data.postulaciones ?? [];
        listaPostulaciones?.replaceChildren();

        if (postulaciones.length === 0) {
          mostrarMensaje("Todavia no hay postulaciones para revisar.", "info");
          return;
        }

        mensajeAdmin?.classList.add("hidden");
        postulaciones.forEach((postulacion: Postulacion) => {
          listaPostulaciones?.appendChild(crearPostulacion(postulacion));
        });

        listaPostulaciones?.querySelectorAll<HTMLButtonElement>("button[data-accion]").forEach((boton) => {
          boton.addEventListener("click", () => {
            const id = boton.dataset.id;
            const accion = boton.dataset.accion as "aprobar" | "rechazar";
            if (id && accion) cambiarEstado(id, accion);
          });
        });
      } catch (error) {
        mostrarMensaje("No se pudo conectar con el servidor.", "error");
      }
    }

    cargarPostulaciones();
  </script>
</Layout>
