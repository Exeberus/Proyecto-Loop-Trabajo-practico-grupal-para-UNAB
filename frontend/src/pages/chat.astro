---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Mensajeria" usuarioLogueado={true}>
  <main class="relative min-h-[calc(100vh-160px)] overflow-hidden bg-[#f5f5f5] px-5 py-12">
    <div class="absolute left-1/2 top-28 z-0 h-80 w-80 -translate-x-1/2 rounded-full bg-[#0047ff]"></div>
    <div class="absolute left-[58%] top-56 z-0 h-72 w-72 rounded-full bg-teal-300"></div>

    <section class="relative z-10 mx-auto max-w-6xl">
      <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-[#0047ff]">
            Mensajeria
          </p>

          <h1 class="mt-2 text-4xl font-extrabold text-[#0047ff]">
            Chat de Loop
          </h1>
        </div>

        <a
          href="/mensajes"
          class="w-fit rounded-full border border-[#0047ff] px-5 py-2 text-[10px] font-bold uppercase text-[#0047ff] transition hover:bg-[#0047ff] hover:text-white"
        >
          Ver notificaciones
        </a>
      </div>

      <div class="grid grid-cols-1 gap-8 lg:grid-cols-[0.85fr_1.4fr]">
        <aside class="h-fit rounded-[24px] bg-white p-5 shadow-xl">
          <div class="mb-5">
            <h2 class="text-xl font-extrabold text-[#081c44]">
              Conversaciones
            </h2>

            <p class="mt-1 text-xs font-semibold text-slate-500">
              Hilos creados por reservas o por contacto directo.
            </p>
          </div>

          <div id="listaConversaciones" class="space-y-3">
            <div class="rounded-2xl bg-slate-50 p-4">
              <p class="text-sm font-bold text-slate-500">
                Cargando conversaciones...
              </p>
            </div>
          </div>

          <div class="mt-6 border-t border-slate-100 pt-5">
            <h3 class="mb-3 text-xs font-bold uppercase tracking-widest text-[#0047ff]">
              Contactos sugeridos
            </h3>

            <div id="contactosSugeridos" class="space-y-2">
              <div class="rounded-2xl bg-slate-50 p-4">
                <p class="text-sm font-bold text-slate-500">
                  Cargando profesores aprobados...
                </p>
              </div>
            </div>
          </div>
        </aside>

        <section class="flex min-h-[620px] flex-col rounded-[28px] bg-white p-6 shadow-xl">
          <div class="mb-5 flex items-start justify-between gap-4 border-b border-slate-100 pb-5">
            <div>
              <p class="text-xs font-bold uppercase tracking-widest text-[#0047ff]">
                Conversacion activa
              </p>

              <h2 id="chatTitulo" class="mt-2 text-3xl font-extrabold text-[#081c44]">
                Elegi un chat
              </h2>
            </div>

            <span
              id="chatEstado"
              class="rounded-full bg-slate-100 px-4 py-2 text-[10px] font-bold uppercase text-slate-500"
            >
              Sin seleccionar
            </span>
          </div>

          <div id="mensajesChat" class="flex-1 space-y-4 overflow-y-auto rounded-2xl bg-slate-50 p-5">
            <div class="mx-auto max-w-md py-16 text-center">
              <p class="text-sm font-bold text-slate-500">
                Selecciona una conversacion o inicia una con un profesor.
              </p>
            </div>
          </div>

          <form id="formMensaje" class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-[1fr_auto]">
            <input
              id="inputMensaje"
              type="text"
              placeholder="Escribi un mensaje..."
              class="rounded-full border border-slate-200 bg-white px-5 py-4 text-sm font-semibold text-[#081c44] outline-none transition focus:border-[#0047ff]"
              disabled
            />

            <button
              id="btnEnviar"
              type="submit"
              class="rounded-full bg-[#0047ff] px-7 py-4 text-[10px] font-bold uppercase text-white shadow-lg shadow-blue-200 transition hover:bg-blue-700 disabled:cursor-not-allowed disabled:bg-slate-300 disabled:shadow-none"
              disabled
            >
              Enviar
            </button>
          </form>

          <p id="chatFeedback" class="mt-3 hidden rounded-xl px-4 py-3 text-sm font-semibold"></p>
        </section>
      </div>
    </section>
  </main>

  <script>
    const API_URL = ["localhost", "127.0.0.1"].includes(window.location.hostname)
      ? "http://127.0.0.1:5000"
      : "https://loop-backend-b1g8.onrender.com";

    const token = localStorage.getItem("token");
    const usuarioGuardado = localStorage.getItem("usuario");
    const usuarioActual = usuarioGuardado ? JSON.parse(usuarioGuardado) : null;

    if (!token) {
      window.location.href = "/login";
    }

    const listaConversaciones = document.getElementById("listaConversaciones") as HTMLDivElement | null;
    const mensajesChat = document.getElementById("mensajesChat") as HTMLDivElement | null;
    const chatTitulo = document.getElementById("chatTitulo") as HTMLHeadingElement | null;
    const chatEstado = document.getElementById("chatEstado") as HTMLSpanElement | null;
    const formMensaje = document.getElementById("formMensaje") as HTMLFormElement | null;
    const inputMensaje = document.getElementById("inputMensaje") as HTMLInputElement | null;
    const btnEnviar = document.getElementById("btnEnviar") as HTMLButtonElement | null;
    const chatFeedback = document.getElementById("chatFeedback") as HTMLParagraphElement | null;
    const contactosSugeridos = document.getElementById("contactosSugeridos") as HTMLDivElement | null;

    let conversacionActiva: number | null = null;

    function mostrarFeedback(mensaje: string, tipo: "ok" | "error" = "ok") {
      if (!chatFeedback) return;

      chatFeedback.textContent = mensaje;
      chatFeedback.className = tipo === "ok"
        ? "mt-3 rounded-xl bg-green-50 px-4 py-3 text-sm font-semibold text-green-700"
        : "mt-3 rounded-xl bg-red-50 px-4 py-3 text-sm font-semibold text-red-600";
    }

    function habilitarChat(habilitado: boolean) {
      if (inputMensaje) inputMensaje.disabled = !habilitado;
      if (btnEnviar) btnEnviar.disabled = !habilitado;
    }

    function escaparHtml(valor: string) {
      return String(valor)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function pintarConversaciones(conversaciones: any[]) {
      if (!listaConversaciones) return;

      if (conversaciones.length === 0) {
        listaConversaciones.innerHTML = `
          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm font-bold text-slate-500">
              Todavia no tenes conversaciones.
            </p>
          </div>
        `;
        return;
      }

      listaConversaciones.innerHTML = conversaciones.map((conversacion) => `
        <button
          type="button"
          data-conversation-id="${conversacion.id}"
          data-user-name="${escaparHtml(conversacion.otherUserName)}"
          class="conversacion-btn w-full rounded-2xl border border-slate-100 bg-slate-50 p-4 text-left transition hover:border-[#0047ff] hover:bg-white"
        >
          <span class="block text-sm font-extrabold text-[#081c44]">
            ${escaparHtml(conversacion.otherUserName)}
          </span>
          <span class="mt-1 block truncate text-xs font-semibold text-slate-500">
            ${escaparHtml(conversacion.lastMessage)}
          </span>
        </button>
      `).join("");

      document.querySelectorAll(".conversacion-btn").forEach((boton) => {
        boton.addEventListener("click", () => {
          const conversationId = Number((boton as HTMLButtonElement).dataset.conversationId);
          const userName = (boton as HTMLButtonElement).dataset.userName || "Usuario Loop";
          abrirConversacion(conversationId, userName);
        });
      });
    }

    async function cargarConversaciones() {
      try {
        const respuesta = await fetch(`${API_URL}/api/conversaciones`, {
          headers: {
            Authorization: `Bearer ${token}`,
          },
        });

        const data = await respuesta.json();

        if (!respuesta.ok) {
          throw new Error(data.mensaje || "No se pudieron cargar las conversaciones.");
        }

        pintarConversaciones(data.conversaciones ?? []);
      } catch (error) {
        console.error(error);
        pintarConversaciones([]);
      }
    }

    function pintarMensajes(mensajes: any[]) {
      if (!mensajesChat) return;

      if (mensajes.length === 0) {
        mensajesChat.innerHTML = `
          <div class="mx-auto max-w-md py-16 text-center">
            <p class="text-sm font-bold text-slate-500">
              Todavia no hay mensajes. Escribi el primero.
            </p>
          </div>
        `;
        return;
      }

      mensajesChat.innerHTML = mensajes.map((mensaje) => {
        const esPropio = Number(mensaje.senderId) === Number(usuarioActual?.id);
        return `
          <div class="flex ${esPropio ? "justify-end" : "justify-start"}">
            <div class="max-w-[78%] rounded-2xl px-5 py-3 ${esPropio ? "bg-[#0047ff] text-white" : "bg-white text-[#081c44] shadow-sm"}">
              <p class="mb-1 text-[10px] font-bold uppercase ${esPropio ? "text-blue-100" : "text-slate-400"}">
                ${esPropio ? "Vos" : escaparHtml(mensaje.senderName)}
              </p>
              <p class="text-sm font-semibold leading-relaxed">
                ${escaparHtml(mensaje.content)}
              </p>
            </div>
          </div>
        `;
      }).join("");

      mensajesChat.scrollTop = mensajesChat.scrollHeight;
    }

    async function abrirConversacion(conversationId: number, userName: string) {
      conversacionActiva = conversationId;
      habilitarChat(true);

      if (chatTitulo) chatTitulo.textContent = userName;
      if (chatEstado) {
        chatEstado.textContent = "Activa";
        chatEstado.className = "rounded-full bg-green-100 px-4 py-2 text-[10px] font-bold uppercase text-green-700";
      }

      try {
        const respuesta = await fetch(`${API_URL}/api/conversaciones/${conversationId}/mensajes`, {
          headers: {
            Authorization: `Bearer ${token}`,
          },
        });

        const data = await respuesta.json();

        if (!respuesta.ok) {
          throw new Error(data.mensaje || "No se pudieron cargar los mensajes.");
        }

        pintarMensajes(data.mensajes ?? []);
      } catch (error) {
        mostrarFeedback("No se pudieron cargar los mensajes.", "error");
      }
    }

    async function crearConversacion(userId: number, userName: string) {
      try {
        const respuesta = await fetch(`${API_URL}/api/conversaciones`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${token}`,
          },
          body: JSON.stringify({
            user_id: userId,
            user_name: userName,
            current_user_name: usuarioActual?.nombre || usuarioActual?.username || "Usuario Loop",
          }),
        });

        const data = await respuesta.json();

        if (!respuesta.ok) {
          throw new Error(data.mensaje || "No se pudo crear la conversacion.");
        }

        await cargarConversaciones();
        await abrirConversacion(data.conversationId, userName);
      } catch (error) {
        mostrarFeedback((error as Error).message, "error");
      }
    }

    function prepararBotonContacto(boton: Element) {
      const userId = Number((boton as HTMLButtonElement).dataset.userId);

      if (Number(usuarioActual?.id) === userId) {
        boton.remove();
        return;
      }

      boton.addEventListener("click", () => {
        const userName = (boton as HTMLButtonElement).dataset.userName || "Profesor Loop";
        crearConversacion(userId, userName);
      });
    }

    document.querySelectorAll(".contacto-btn").forEach(prepararBotonContacto);

    async function cargarContactosAprobados() {
      if (!contactosSugeridos) return;

      try {
        const respuesta = await fetch(`${API_URL}/api/profesores`);
        const data = await respuesta.json();

        if (!respuesta.ok || !Array.isArray(data.profesores)) return;

        const profesoresAprobados = data.profesores.filter(
          (profe: any) => Number(usuarioActual?.id) !== Number(profe.id)
        );

        contactosSugeridos.replaceChildren();

        if (profesoresAprobados.length === 0) {
          contactosSugeridos.innerHTML = `
            <div class="rounded-2xl bg-slate-50 p-4">
              <p class="text-sm font-bold text-slate-500">
                Todavia no hay profesores aprobados para iniciar chat.
              </p>
            </div>
          `;
          return;
        }

        profesoresAprobados.forEach((profe: any) => {
          if (Number(usuarioActual?.id) === Number(profe.id)) return;
          if (contactosSugeridos.querySelector(`[data-user-id="${profe.id}"]`)) return;

          const boton = document.createElement("button");
          boton.type = "button";
          boton.dataset.userId = String(profe.id);
          boton.dataset.userName = profe.nombre;
          boton.className =
            "contacto-btn flex w-full items-center justify-between rounded-2xl border border-slate-100 bg-slate-50 px-4 py-3 text-left transition hover:border-[#0047ff] hover:bg-white";
          boton.innerHTML = `
            <span>
              <span class="block text-sm font-extrabold text-[#081c44]">
                ${escaparHtml(profe.nombre)}
              </span>
              <span class="block text-xs font-semibold text-slate-500">
                ${escaparHtml((profe.materias ?? []).join(" · "))}
              </span>
            </span>
            <span class="rounded-full bg-[#0047ff] px-3 py-1 text-[10px] font-bold uppercase text-white">
              Chat
            </span>
          `;

          contactosSugeridos.appendChild(boton);
          prepararBotonContacto(boton);
        });
      } catch (error) {
        console.error("No se pudieron cargar contactos aprobados");
      }
    }

    formMensaje?.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!conversacionActiva || !inputMensaje) return;

      const conversationId = conversacionActiva;
      const content = inputMensaje.value.trim();

      if (!content) return;

      try {
        habilitarChat(false);

        const respuesta = await fetch(`${API_URL}/api/conversaciones/${conversationId}/mensajes`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${token}`,
          },
          body: JSON.stringify({ content }),
        });

        const data = await respuesta.json();

        if (!respuesta.ok) {
          throw new Error(data.mensaje || "No se pudo enviar el mensaje.");
        }

        inputMensaje.value = "";
        await abrirConversacion(conversationId, chatTitulo?.textContent || "Conversacion");
        await cargarConversaciones();
      } catch (error) {
        mostrarFeedback((error as Error).message, "error");
        habilitarChat(true);
      }
    });

    async function abrirDesdeUrl() {
      const params = new URLSearchParams(window.location.search);
      const userId = Number(params.get("user"));
      const userName = params.get("name") || "Profesor Loop";

      if (!userId) return;

      await crearConversacion(userId, userName);
      window.history.replaceState({}, "", "/chat");
    }

    cargarContactosAprobados();
    cargarConversaciones().then(abrirDesdeUrl);
  </script>
</Layout>
