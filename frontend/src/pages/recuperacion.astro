---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Recuperar contraseña">
  <main class="flex min-h-[calc(100vh-160px)] items-center justify-center bg-slate-50 px-5 py-12">
    <section class="w-full max-w-md rounded-[28px] border border-slate-100 bg-white p-8 shadow-xl md:p-10">
      <div class="mb-8 text-center">
        <h1 class="mb-2 text-3xl font-extrabold text-[#0047ff]">
          Recuperá tu acceso
        </h1>

        <p class="text-sm font-medium leading-relaxed text-slate-500">
          Ingresá tu correo y te enviaremos las instrucciones para restablecer la contraseña.
        </p>
      </div>

      <form id="formRecuperacion" class="flex flex-col gap-5">
        <div>
          <label
            for="email"
            class="mb-2 block text-xs font-bold uppercase tracking-widest text-[#081c44]"
          >
            Email
          </label>

          <input
            type="email"
            id="email"
            name="email"
            placeholder="tumail@ejemplo.com"
            autocomplete="email"
            required
            class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-800 outline-none transition focus:border-[#0047ff] focus:ring-2 focus:ring-blue-100"
          />
        </div>

        <p
          id="mensajeRecuperacion"
          class="hidden rounded-xl px-4 py-3 text-sm font-semibold"
        >
        </p>

        <button
          type="submit"
          class="mt-2 w-full rounded-full bg-[#0047ff] px-8 py-4 text-xs font-bold uppercase tracking-widest text-white shadow-md transition hover:bg-blue-700"
        >
          Enviar instrucciones
        </button>
      </form>

      <a
        href="/login"
        class="mt-7 inline-block text-[10px] font-bold uppercase tracking-wider text-[#0047ff] underline"
      >
        &lt; Volver al login
      </a>
    </section>
  </main>

  <script>
    const formRecuperacion = document.getElementById("formRecuperacion") as HTMLFormElement | null;
    const mensajeRecuperacion = document.getElementById("mensajeRecuperacion") as HTMLParagraphElement | null;

    formRecuperacion?.addEventListener("submit", (evento) => {
      evento.preventDefault();

      if (!mensajeRecuperacion) return;

      mensajeRecuperacion.textContent =
        "Si el correo está registrado, recibirás un enlace de recuperación.";
      mensajeRecuperacion.className =
        "rounded-xl bg-green-50 px-4 py-3 text-sm font-semibold text-green-600";
    });
  </script>
</Layout>
