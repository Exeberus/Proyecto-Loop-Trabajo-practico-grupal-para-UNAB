---
import Layout from "../layouts/Layout.astro";

const materias = [
  "Matemática",
  "Programación",
  "Física",
  "Inglés",
  "Química",
  "Sistemas",
  "Diseño",
];

const dias = [
  { label: "LUN", value: "lunes" },
  { label: "MAR", value: "martes" },
  { label: "MIE", value: "miercoles" },
  { label: "JUE", value: "jueves" },
  { label: "VIE", value: "viernes" },
  { label: "SAB", value: "sabado" },
  { label: "DOM", value: "domingo" },
];

const horarios = ["15:00", "16:00", "17:00", "18:00", "19:00"];
---

<Layout title="Registro como profe">
  <main class="relative mx-auto flex min-h-[calc(100vh-160px)] w-full max-w-6xl flex-col items-center justify-between gap-12 overflow-hidden px-6 py-12 md:flex-row">
    
    <div class="absolute left-1/2 top-1/2 -z-10 h-[420px] w-[420px] -translate-x-1/4 -translate-y-1/2 rounded-full bg-teal-300/80"></div>

    <section class="w-full md:w-1/2">
      <h1 class="mb-16 text-4xl font-extrabold leading-tight tracking-tight text-[#0047ff] md:text-5xl">
        Convertite en profe<br />
        para poder<br />
        ganar <span class="text-[#081c44]">Tokens</span>
      </h1>

      <a
        href="/register"
        class="text-[10px] font-bold uppercase tracking-wide text-[#0047ff] underline transition hover:text-blue-700"
      >
        Volver a alumno
      </a>

      <div class="mt-8 max-w-sm rounded-[24px] bg-white p-5 shadow-lg">
        <p class="text-[10px] font-bold uppercase tracking-widest text-[#0047ff]">
          Tu postulación
        </p>
        <p id="resumenPostulacion" class="mt-3 text-sm font-bold leading-relaxed text-[#081c44]">
          Elegí una materia, disponibilidad y certificado para enviar tu perfil.
        </p>
      </div>
    </section>

    <section class="relative z-10 flex w-full justify-end md:w-1/2">
      <div class="w-full max-w-lg rounded-[2rem] border border-slate-100 bg-white/95 p-8 shadow-2xl backdrop-blur-sm md:p-10">
        <form id="formRegistroProfe" class="space-y-6">
          
          <div>
            <label for="materia" class="mb-2 block text-sm font-bold text-[#081c44]">
              Materia
            </label>

            <select
              id="materia"
              name="materia"
              required
              class="w-full cursor-pointer rounded-full border border-slate-200 bg-slate-50 px-5 py-3.5 text-sm font-medium text-slate-700 outline-none transition focus:ring-2 focus:ring-[#0047ff]"
            >
              <option value="" disabled selected>Seleccioná una materia...</option>
              {materias.map((materia) => (
                <option value={materia.toLowerCase()}>{materia}</option>
              ))}
            </select>
          </div>

          <div>
            <label for="descripcion" class="mb-2 block text-sm font-bold text-[#081c44]">
              Descripción de tu perfil como profe
            </label>

            <textarea
              id="descripcion"
              name="descripcion"
              rows="3"
              required
              placeholder="Contá brevemente cómo podés ayudar a otros estudiantes..."
              class="w-full resize-none rounded-2xl border border-slate-200 bg-slate-50 px-5 py-3.5 text-sm outline-none transition focus:ring-2 focus:ring-[#0047ff]"
            ></textarea>
          </div>

          <div>
            <p class="mb-3 block text-sm font-bold text-[#081c44]">
              ¿Qué días tenés disponibles?
            </p>

            <div class="flex flex-wrap gap-2">
              {dias.map((dia) => (
                <label class="cursor-pointer">
                  <input
                    type="checkbox"
                    name="dias"
                    value={dia.value}
                    class="peer hidden"
                  />
                  <span class="block rounded-full border border-[#081c44] px-4 py-1.5 text-[10px] font-bold text-[#081c44] transition peer-checked:bg-[#081c44] peer-checked:text-white hover:bg-[#081c44] hover:text-white">
                    {dia.label}
                  </span>
                </label>
              ))}
            </div>
          </div>

          <div>
            <p class="mb-3 block text-sm font-bold text-[#081c44]">
              ¿Qué horarios tenés disponibles?
            </p>

            <div class="flex flex-wrap gap-2">
              {horarios.map((horario) => (
                <label class="cursor-pointer">
                  <input
                    type="checkbox"
                    name="horarios"
                    value={horario}
                    class="peer hidden"
                  />
                  <span class="block rounded-full border border-[#081c44] px-4 py-1.5 text-[10px] font-bold text-[#081c44] transition peer-checked:bg-[#0047ff] peer-checked:text-white hover:bg-[#0047ff] hover:text-white">
                    {horario}
                  </span>
                </label>
              ))}
            </div>
          </div>

          <div>
            <label
              for="certificado"
              class="block cursor-pointer text-[10px] font-bold uppercase leading-tight text-[#0047ff] underline transition hover:text-blue-700"
            >
              Adjuntar certificado de materias aprobadas
              <span class="ml-1 text-red-500">*Obligatorio*</span>
            </label>

            <input
              type="file"
              id="certificado"
              name="certificado"
              accept=".pdf,image/*"
              required
              class="mt-3 block w-full text-xs text-slate-500 file:mr-4 file:rounded-full file:border-0 file:bg-[#0047ff] file:px-4 file:py-2 file:text-xs file:font-bold file:text-white hover:file:bg-blue-700"
            />

            <p id="nombreCertificado" class="mt-2 hidden text-xs font-bold text-slate-500">
            </p>
          </div>

          <p
            id="mensajeRegistroProfe"
            class="hidden rounded-xl px-4 py-3 text-sm font-semibold"
          >
          </p>

          <div class="flex justify-end pt-2">
            <button
              id="btnRegistroProfe"
              type="submit"
              class="rounded-full bg-[#0047ff] px-8 py-3.5 text-xs font-bold uppercase text-white shadow-md transition hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-60"
            >
              Continuar
            </button>
          </div>
        </form>
      </div>
    </section>
  </main>

  <script>
    const API_URL = "http://localhost:5000";

    const formRegistroProfe = document.getElementById("formRegistroProfe") as HTMLFormElement | null;
    const mensajeRegistroProfe = document.getElementById("mensajeRegistroProfe") as HTMLParagraphElement | null;
    const btnRegistroProfe = document.getElementById("btnRegistroProfe") as HTMLButtonElement | null;
    const resumenPostulacion = document.getElementById("resumenPostulacion") as HTMLParagraphElement | null;
    const nombreCertificado = document.getElementById("nombreCertificado") as HTMLParagraphElement | null;

    type TipoMensaje = "error" | "ok";

    function mostrarMensaje(texto: string, tipo: TipoMensaje) {
      if (!mensajeRegistroProfe) return;

      mensajeRegistroProfe.textContent = texto;
      mensajeRegistroProfe.classList.remove("hidden");

      if (tipo === "error") {
        mensajeRegistroProfe.className =
          "rounded-xl bg-red-50 px-4 py-3 text-sm font-semibold text-red-600";
      }

      if (tipo === "ok") {
        mensajeRegistroProfe.className =
          "rounded-xl bg-green-50 px-4 py-3 text-sm font-semibold text-green-600";
      }
    }

    if (formRegistroProfe && btnRegistroProfe) {
      const selectMateria = document.getElementById("materia") as HTMLSelectElement | null;
      const certificado = document.getElementById("certificado") as HTMLInputElement | null;

      function actualizarResumen() {
        if (!resumenPostulacion) return;

        const materia = selectMateria?.selectedOptions[0]?.textContent?.trim() || "Materia pendiente";
        const dias = Array.from(
          formRegistroProfe.querySelectorAll<HTMLInputElement>('input[name="dias"]:checked')
        ).map((input) => input.parentElement?.textContent?.trim()).filter(Boolean);
        const horarios = Array.from(
          formRegistroProfe.querySelectorAll<HTMLInputElement>('input[name="horarios"]:checked')
        ).map((input) => input.value);

        resumenPostulacion.textContent =
          `${materia} · ${dias.length ? dias.join(", ") : "sin días"} · ${horarios.length ? horarios.join(", ") : "sin horarios"}`;
      }

      formRegistroProfe.addEventListener("change", actualizarResumen);

      certificado?.addEventListener("change", () => {
        if (!nombreCertificado) return;

        const archivo = certificado.files?.[0];
        nombreCertificado.textContent = archivo
          ? `Certificado seleccionado: ${archivo.name}`
          : "";
        nombreCertificado.classList.toggle("hidden", !archivo);
      });

      formRegistroProfe.addEventListener("submit", async (evento) => {
        evento.preventDefault();

        const diasSeleccionados = formRegistroProfe.querySelectorAll<HTMLInputElement>('input[name="dias"]:checked');
        const horariosSeleccionados = formRegistroProfe.querySelectorAll<HTMLInputElement>('input[name="horarios"]:checked');

        if (diasSeleccionados.length === 0) {
          mostrarMensaje("Seleccioná al menos un día disponible.", "error");
          return;
        }

        if (horariosSeleccionados.length === 0) {
          mostrarMensaje("Seleccioná al menos un horario disponible.", "error");
          return;
        }

        const formData = new FormData(formRegistroProfe);
        const token = localStorage.getItem("token");

        try {
          btnRegistroProfe.disabled = true;
          btnRegistroProfe.textContent = "Enviando...";

          const respuesta = await fetch(`${API_URL}/api/registro-profe`, {
            method: "POST",
            headers: {
              Authorization: `Bearer ${token}`,
            },
            body: formData,
          });

          const data = await respuesta.json();

          if (!respuesta.ok) {
            mostrarMensaje(data.mensaje || "No se pudo enviar la postulación.", "error");
            return;
          }

          mostrarMensaje("Postulación enviada correctamente. Redirigiendo...", "ok");

          setTimeout(() => {
            window.location.href = "/perfil";
          }, 900);
        } catch (error) {
          mostrarMensaje(
            "No se pudo conectar con el servidor. Verificá que Flask esté ejecutándose.",
            "error"
          );
        } finally {
          btnRegistroProfe.disabled = false;
          btnRegistroProfe.textContent = "Continuar";
        }
      });
    }
  </script>
</Layout>
