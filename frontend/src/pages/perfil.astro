---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Loop - Mi Perfil" usuarioLogueado={true}>
  <div class="w-full min-h-[calc(100vh-100px)] bg-[#F5F5F5] pt-12 px-6 flex flex-col items-center">
    <div class="w-full max-w-5xl flex flex-col gap-8 mb-20">
      
      <!-- Titulo de la seccion -->
      <h1 class="text-4xl font-bold text-blue-600 tracking-tight text-left">Mi Perfil</h1>

      <!-- Fila Superior: Perfil + Saldo -->
      <div class="flex flex-col md:flex-row w-full gap-6">
        
        <!-- Tarjeta de Usuario -->
        <div class="w-full md:w-1/3 bg-white rounded-[2rem] p-8 shadow-lg flex flex-col items-center text-center border border-gray-100">
          <div class="w-24 h-24 bg-blue-100 rounded-full mb-4 overflow-hidden flex items-center justify-center shadow-inner">
            <span class="text-4xl font-bold text-blue-600">A</span>
          </div>
          <h2 id="nombre-usuario" ...>Alumno UNAB</h2>
          <p class="text-sm text-slate-500 font-medium mb-6">Estudiante</p>
          <button class="text-[10px] font-bold text-blue-600 border-2 border-blue-600 px-6 py-2 rounded-full hover:bg-blue-50 transition uppercase tracking-wider">
            EDITAR PERFIL
          </button>
        </div>

        <!-- Tarjeta de Saldo -->
        <div class="w-full md:w-2/3 bg-gradient-to-br from-blue-600 to-[#00f2fe] rounded-[2rem] p-8 shadow-xl flex flex-col justify-center items-center relative overflow-hidden group">
          <div class="absolute -bottom-10 -right-10 w-48 h-48 bg-white/20 rounded-full blur-2xl"></div>
          
          <h3 class="text-blue-100 text-lg font-bold mb-2 z-10">Saldo Disponible</h3>
          <div class="flex text-white items-center justify-center gap-3 z-10 drop-shadow-md">
        <span id="saldo-tokens" class="font-extrabold text-[6rem] leading-none tracking-tighter">0</span>
        <span class="text-2xl font-bold tracking-widest uppercase mt-4">Tokens</span>
      </div>

          <p class="text-blue-50 text-sm mt-4 z-10 text-center max-w-md font-medium">
            Usá tus tokens para reservar clases con profes. Recordá que podés ganar más tokens si te postulás para dar clases.
          </p>
        </div>
      </div>

      <!-- Fila Inferior: Historial / Próximas Clases -->
      <div class="w-full bg-white rounded-[2rem] p-8 md:p-10 shadow-lg border border-gray-100">
        <h3 class="text-xl font-bold text-slate-800 mb-6 text-left">Mis próximas clases</h3>
        
        <div class="flex flex-col gap-4">
          
          <!-- TARJETA DE RESERVA (Oculta por defecto con display:none) -->
          <div id="tarjeta-reserva" style="display: none;" class="flex flex-col md:flex-row justify-between items-center bg-gray-50 rounded-2xl p-5 border border-gray-100 gap-4 hover:shadow-md transition">
            <div class="flex items-center gap-4 w-full md:w-auto">
              <div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
              </div>
              <div class="text-left">
                <h4 class="font-bold text-slate-800">Programación <span class="text-slate-500 font-normal text-sm">(con Tomás T.)</span></h4>
                <!-- Horario fijo a las 15:00 -->
                <p class="text-sm text-blue-600 font-bold mt-0.5">Jueves 18 de Junio - 15:00 hs</p>
              </div>
            </div>
            
            <div class="flex gap-2 w-full md:w-auto">
              <button class="flex-1 md:flex-none text-[10px] font-bold text-blue-600 border-2 border-blue-600 px-6 py-2.5 rounded-full hover:bg-blue-50 transition text-center tracking-wider">
                VER LINK
              </button>
              <button id="btnCancelar" class="flex-1 md:flex-none text-[10px] font-bold text-white bg-slate-800 px-6 py-2.5 rounded-full hover:bg-slate-700 transition text-center tracking-wider">
                CANCELAR
              </button>
            </div>
          </div>

          <!-- ESTADO VACÍO (Visible por defecto) -->
          <div id="estado-vacio" class="text-center py-6 mt-4">
            <p class="text-sm text-slate-400 font-medium">No tenés más clases programadas.</p>
            <a href="/" class="text-xs font-bold text-blue-600 underline hover:text-slate-800 transition mt-2 inline-block uppercase tracking-wider">
              BUSCAR PROFESOR
            </a>
          </div>

        </div>
      </div>

    </div>
  </div>

<!-- SCRIPT INTEGRADO: RESERVAS Y DATOS DE USUARIO -->
  <script is:inline>
    const cargarDatosYReservas = async () => {
      // --- LÓGICA DE RESERVAS (Lo que ya tenías) ---
      const tarjetaReserva = document.getElementById('tarjeta-reserva');
      const estadoVacio = document.getElementById('estado-vacio');
      const btnCancelar = document.getElementById('btnCancelar');

      if (localStorage.getItem('reserva_activa') === 'true') {
        if(tarjetaReserva) tarjetaReserva.style.display = 'flex';
        if(estadoVacio) estadoVacio.style.display = 'none';
      } else {
        if(tarjetaReserva) tarjetaReserva.style.display = 'none';
        if(estadoVacio) estadoVacio.style.display = 'block';
      }

      if (btnCancelar) {
        btnCancelar.onclick = () => {
          localStorage.removeItem('reserva_activa'); 
          if(tarjetaReserva) tarjetaReserva.style.display = 'none';
          if(estadoVacio) estadoVacio.style.display = 'block';
        };
      }

      // --- LÓGICA DE BACKEND (Lo nuevo) ---
      const token = localStorage.getItem('token');
      if (token) {
        try {
          const respuesta = await fetch('http://127.0.0.1:5000/api/perfil', {
            headers: { 'Authorization': `Bearer ${token}` }
          });
          
          if (respuesta.ok) {
            const usuario = await respuesta.json();
            // Asegurate de tener id="nombre-usuario" y id="saldo-tokens" en tu HTML
            document.getElementById('nombre-usuario').innerText = usuario.nombre;
            document.getElementById('saldo-tokens').innerText = usuario.tokens;
          }
        } catch (error) {
      console.error("¡ERROR DE CONEXIÓN CON EL BACKEND!", error);
      alert("No se pudo conectar al servidor. Mirá la consola (F12) para ver por qué.");
    }
      }
    };

    cargarDatosYReservas();
    document.addEventListener('astro:page-load', cargarDatosYReservas);
  </script>