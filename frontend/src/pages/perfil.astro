---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Loop - Mi Perfil" usuarioLogueado={true}>
  <div class="w-full min-h-[calc(100vh-100px)] bg-[#F5F5F5] pt-12 px-6 flex flex-col items-center">
    <div class="w-full max-w-5xl flex flex-col gap-8 mb-20">
      
      <!-- Titulo de la seccion -->
      <h1 class="text-4xl font-bold text-blue-600 tracking-tight text-left">Mi Perfil</h1>

      <!-- Fila Superior: Perfil + Saldo -->
      <div class="flex flex-col md:flex-row w-full gap-6">
        
        <!-- Tarjeta de Usuario -->
        <div class="w-full md:w-1/3 bg-white rounded-[2rem] p-8 shadow-lg flex flex-col items-center text-center border border-gray-100">
          <div class="w-28 h-28 bg-blue-100 rounded-full mb-4 overflow-hidden flex items-center justify-center shadow-inner">
            <img
              id="foto-usuario"
              src=""
              alt="Foto de perfil"
              class="hidden h-full w-full object-cover"
            />
            <span id="inicial-usuario" class="text-4xl font-bold text-blue-600">A</span>
          </div>
          <h2 id="nombre-usuario" class="text-2xl font-extrabold text-slate-800">Alumno UNAB</h2>
          <p id="rol-usuario" class="text-sm text-slate-500 font-medium">Estudiante</p>
          <p id="speech-usuario" class="my-5 max-w-xs text-sm font-medium leading-relaxed text-slate-500">
            Usá Loop para aprender, reservar clases y compartir conocimientos con otros estudiantes.
          </p>
          <div id="materias-usuario" class="mb-5 flex max-w-xs flex-wrap justify-center gap-2">
            <span class="rounded-full border border-slate-200 px-3 py-1 text-[10px] font-bold uppercase text-slate-400">
              Sin materias cargadas
            </span>
          </div>
         <a
          href="/editar-perfil"
            class="rounded-full bg-[#0047ff] px-6 py-3 text-[10px] font-bold uppercase text-white shadow-md transition hover:bg-blue-700">
            Editar perfil
          </a>
        </div>

        <!-- Tarjeta de Saldo -->
        <div class="w-full md:w-2/3 bg-gradient-to-br from-blue-600 to-[#00f2fe] rounded-[2rem] p-8 shadow-xl flex flex-col justify-center items-center relative overflow-hidden group">
          <div class="absolute -bottom-10 -right-10 w-48 h-48 bg-white/20 rounded-full blur-2xl"></div>
          
          <h3 class="text-blue-100 text-lg font-bold mb-2 z-10">Saldo Disponible</h3>
          <div class="flex text-white items-center justify-center gap-3 z-10 drop-shadow-md">
        <span id="saldo-tokens" class="font-extrabold text-[6rem] leading-none tracking-tighter">0</span>
        <span class="text-2xl font-bold tracking-widest uppercase mt-4">Tokens</span>
      </div>

          <p class="text-blue-50 text-sm mt-4 z-10 text-center max-w-md font-medium">
            Usá tus tokens para reservar clases con profes. Recordá que podés ganar más tokens si te postulás para dar clases.
          </p>
        </div>
      </div>

      <!-- Fila Inferior: Historial / Próximas Clases -->
      <div id="tarjeta-postulacion-profe" class="hidden w-full bg-white rounded-[2rem] p-8 md:p-10 shadow-lg border border-gray-100">
        <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
          <div>
            <p class="text-xs font-bold uppercase tracking-widest text-[#0047ff]">
              Perfil como profe
            </p>
            <h3 class="mt-2 text-xl font-bold text-slate-800">
              Postulación enviada
            </h3>
            <p id="postulacion-detalle" class="mt-2 text-sm font-semibold leading-relaxed text-slate-500">
            </p>
          </div>

          <span
            id="postulacion-estado"
            class="w-fit rounded-full bg-yellow-100 px-4 py-2 text-[10px] font-bold uppercase text-yellow-700"
          >
            Pendiente
          </span>
        </div>

        <div id="postulacion-chips" class="mt-5 flex flex-wrap gap-2">
        </div>
      </div>

      <div class="w-full bg-white rounded-[2rem] p-8 md:p-10 shadow-lg border border-gray-100">
        <h3 class="text-xl font-bold text-slate-800 mb-6 text-left">Mis próximas clases</h3>
        
        <div class="flex flex-col gap-4">
          
          <!-- TARJETA DE RESERVA (Oculta por defecto con display:none) -->
          <div id="tarjeta-reserva" style="display: none;" class="flex flex-col md:flex-row justify-between items-center bg-gray-50 rounded-2xl p-5 border border-gray-100 gap-4 hover:shadow-md transition">
            <div class="flex items-center gap-4 w-full md:w-auto">
              <div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
              </div>
              <div class="text-left">
                <h4 id="perfil-reserva-titulo" class="font-bold text-slate-800">Clase reservada</h4>
                <p id="perfil-reserva-detalle" class="text-sm text-blue-600 font-bold mt-0.5">Turno pendiente</p>
              </div>
            </div>
            
            <div class="flex gap-2 w-full md:w-auto">
              <a
                id="linkReservaPerfil"
                href="/mensajes"
                class="flex-1 md:flex-none text-[10px] font-bold text-blue-600 border-2 border-blue-600 px-6 py-2.5 rounded-full hover:bg-blue-50 transition text-center tracking-wider"
              >
                VER LINK
              </a>
              <button id="btnCancelar" class="flex-1 md:flex-none text-[10px] font-bold text-white bg-slate-800 px-6 py-2.5 rounded-full hover:bg-slate-700 transition text-center tracking-wider">
                CANCELAR
              </button>
            </div>
          </div>

          <!-- ESTADO VACÍO (Visible por defecto) -->
          <div id="estado-vacio" class="text-center py-6 mt-4">
            <p class="text-sm text-slate-400 font-medium">No tenés más clases programadas.</p>
            <a href="/profesores" class="text-xs font-bold text-blue-600 underline hover:text-slate-800 transition mt-2 inline-block uppercase tracking-wider">
              BUSCAR PROFESOR
            </a>
          </div>

        </div>
      </div>

    </div>
  </div>

<!-- SCRIPT INTEGRADO: RESERVAS Y DATOS DE USUARIO -->
  <script is:inline>
    const API_URL = 'https://loop-backend-b1g8.onrender.com';

    const cargarDatosYReservas = async () => {
      // --- LÓGICA DE RESERVAS (Lo que ya tenías) ---
      const tarjetaReserva = document.getElementById('tarjeta-reserva');
      const estadoVacio = document.getElementById('estado-vacio');
      const btnCancelar = document.getElementById('btnCancelar');
      const tituloReserva = document.getElementById('perfil-reserva-titulo');
      const detalleReserva = document.getElementById('perfil-reserva-detalle');
      const linkReservaPerfil = document.getElementById('linkReservaPerfil');
      const tarjetaPostulacion = document.getElementById('tarjeta-postulacion-profe');
      const postulacionDetalle = document.getElementById('postulacion-detalle');
      const postulacionEstado = document.getElementById('postulacion-estado');
      const postulacionChips = document.getElementById('postulacion-chips');

      let reservaActiva = null;

      if(tarjetaReserva) tarjetaReserva.style.display = 'none';
      if(estadoVacio) estadoVacio.style.display = 'block';

      if (btnCancelar) {
        btnCancelar.onclick = async () => {
          if (!reservaActiva) return;

          try {
            await fetch(`${API_URL}/api/reservas/${reservaActiva.id}/cancelar`, {
              method: 'PATCH',
              headers: { 'Authorization': `Bearer ${token}` },
            });
          } catch (error) {
            console.error("No se pudo cancelar la reserva", error);
          }

          localStorage.removeItem('reservaDemo');
          if(tarjetaReserva) tarjetaReserva.style.display = 'none';
          if(estadoVacio) estadoVacio.style.display = 'block';
        };
      }

      // --- LÓGICA DE BACKEND (Lo nuevo) ---
      const token = localStorage.getItem('token');
      if (!token) {
        window.location.href = "/login";
      return;
      }
      if (token) {
        try {
          const respuesta = await fetch(`${API_URL}/api/perfil`, {
            headers: { 'Authorization': `Bearer ${token}` }
          });
          
          if (respuesta.ok) {
            const data = await respuesta.json();
            const usuario = data.usuario;
            const postulacion = data.postulacion;

            document.getElementById('nombre-usuario').innerText = usuario.nombre;
            document.getElementById('saldo-tokens').innerText = usuario.tokens;

            const rolUsuario = document.getElementById('rol-usuario');
            if (rolUsuario) {
              if (postulacion?.estado === 'pendiente') {
                rolUsuario.textContent = 'Estudiante / Profe pendiente';
              } else if (usuario.rol === 'profe') {
                rolUsuario.textContent = 'Estudiante / Profe';
              } else {
                rolUsuario.textContent = 'Estudiante';
              }
            }

            const inicialUsuario = document.getElementById('inicial-usuario');
            if (inicialUsuario) {
              inicialUsuario.textContent = String(usuario.nombre ?? "A").trim().charAt(0).toUpperCase() || "A";
            }

            localStorage.setItem('usuario', JSON.stringify(usuario));

            if (postulacion && tarjetaPostulacion) {
              tarjetaPostulacion.classList.remove('hidden');

              if (postulacionDetalle) {
                postulacionDetalle.textContent =
                  `${postulacion.materia} · certificado: ${postulacion.certificadoNombre}`;
              }

              if (postulacionEstado) {
                postulacionEstado.textContent = postulacion.estado || 'Pendiente';
              }

              if (postulacionChips) {
                const dias = Array.isArray(postulacion.dias) ? postulacion.dias : [];
                const horarios = Array.isArray(postulacion.horarios) ? postulacion.horarios : [];
                const chips = [...dias, ...horarios];

                postulacionChips.innerHTML = chips.map((item) => `
                  <span class="rounded-full border border-[#0047ff] px-3 py-1 text-[10px] font-bold uppercase text-[#0047ff]">
                    ${item}
                  </span>
                `).join('');
              }
            }
          }

          const respuestaReserva = await fetch(`${API_URL}/api/reservas/activa`, {
            headers: { 'Authorization': `Bearer ${token}` }
          });

          if (respuestaReserva.ok) {
            const dataReserva = await respuestaReserva.json();
            reservaActiva = dataReserva.reserva;

            if (reservaActiva) {
              if(tarjetaReserva) tarjetaReserva.style.display = 'flex';
              if(estadoVacio) estadoVacio.style.display = 'none';
              if(tituloReserva) tituloReserva.textContent = `Clase con ${reservaActiva.profesorNombre}`;
              if(detalleReserva) detalleReserva.textContent = reservaActiva.turno;
              if(linkReservaPerfil instanceof HTMLAnchorElement) {
                linkReservaPerfil.href = reservaActiva.meet || "/mensajes";
                linkReservaPerfil.target = reservaActiva.meet ? "_blank" : "_self";
              }
              localStorage.setItem('reservaDemo', JSON.stringify(reservaActiva));
            }
          }
        } catch (error) {
      console.error("¡ERROR DE CONEXIÓN CON EL BACKEND!", error);
      alert("No se pudo conectar al servidor. Mirá la consola (F12) para ver por qué.");
    }
      }
    };
    
    function cargarPerfilEditado() {
  const usuarioGuardado = localStorage.getItem("usuario");
  const usuarioActual = usuarioGuardado ? JSON.parse(usuarioGuardado) : null;
  const emailPerfil = String(usuarioActual?.email ?? "").trim().toLowerCase();
  const identificador =
    emailPerfil ||
    usuarioActual?.id ||
    usuarioActual?.nombre ||
    "anonimo";

  const perfilGuardado = localStorage.getItem(`perfilDemo:${identificador}`);

  const speechUsuario = document.getElementById("speech-usuario");
const fotoUsuario = document.getElementById("foto-usuario");
const inicialUsuario = document.getElementById("inicial-usuario");
const materiasUsuario = document.getElementById("materias-usuario");

  if (!perfilGuardado) {
    if (speechUsuario) {
      speechUsuario.textContent =
        "Usá Loop para aprender, reservar clases y compartir conocimientos con otros estudiantes.";
    }

    if (fotoUsuario instanceof HTMLImageElement) {
      fotoUsuario.src = "";
      fotoUsuario.classList.add("hidden");
      inicialUsuario?.classList.remove("hidden");
    }

    if (materiasUsuario) {
      materiasUsuario.innerHTML = `
        <span class="rounded-full border border-slate-200 px-3 py-1 text-[10px] font-bold uppercase text-slate-400">
          Sin materias cargadas
        </span>
      `;
    }

    return;
  }

  const perfilDemo = JSON.parse(perfilGuardado);

  if (speechUsuario) {
    speechUsuario.textContent = perfilDemo.speech;
  }

  if (fotoUsuario instanceof HTMLImageElement && perfilDemo.foto) {
  fotoUsuario.src = perfilDemo.foto;
  fotoUsuario.classList.remove("hidden");
  inicialUsuario?.classList.add("hidden");
}

  if (materiasUsuario) {
    const materias = Array.isArray(perfilDemo.materias) ? perfilDemo.materias : [];

    materiasUsuario.innerHTML = materias.length
      ? materias.map((materia) => `
          <span class="rounded-full border border-[#0047ff] px-3 py-1 text-[10px] font-bold uppercase text-[#0047ff]">
            ${materia}
          </span>
        `).join("")
      : `
          <span class="rounded-full border border-slate-200 px-3 py-1 text-[10px] font-bold uppercase text-slate-400">
            Sin materias cargadas
          </span>
        `;
  }
  }

cargarDatosYReservas();
cargarPerfilEditado();

document.addEventListener("astro:page-load", () => {
  cargarDatosYReservas();
  cargarPerfilEditado();
});
  </script>
