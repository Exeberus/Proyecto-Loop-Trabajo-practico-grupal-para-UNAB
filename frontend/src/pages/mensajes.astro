---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Notificaciones" usuarioLogueado={true}>
  <main class="relative min-h-[calc(100vh-160px)] overflow-hidden bg-[#f5f5f5] px-5 py-12">
    <div class="absolute left-1/2 top-24 z-0 h-80 w-80 -translate-x-1/2 rounded-full bg-[#0047ff]"></div>
    <div class="absolute left-[55%] top-48 z-0 h-72 w-72 rounded-full bg-teal-300"></div>

    <section class="relative z-10 mx-auto max-w-6xl">
      <h1 class="mb-8 text-4xl font-extrabold text-[#0047ff]">
        Notificaciones
      </h1>

      <div class="grid grid-cols-1 gap-8 lg:grid-cols-[0.8fr_1.4fr]">
        <aside class="h-fit rounded-[24px] bg-white p-5 shadow-xl">
          <div class="mb-4 flex items-center justify-between">
            <h2 class="text-xl font-extrabold text-[#081c44]">
              Notificaciones
            </h2>

            <span class="rounded-full bg-[#0047ff] px-3 py-1 text-[10px] font-bold uppercase text-white">
              Centro Loop
            </span>
          </div>

          <div id="listaMensajes" class="space-y-3">
            <div class="rounded-2xl border-l-4 border-red-500 bg-slate-50 p-4">
              <p class="text-sm font-bold text-[#081c44]">
                Cargando notificaciones...
              </p>
            </div>
          </div>
        </aside>

        <section class="rounded-[28px] bg-white p-8 shadow-xl">
          <div class="mb-6">
            <p class="text-xs font-bold uppercase tracking-widest text-[#0047ff]">
              Centro de validación
            </p>

            <h2 class="mt-2 text-3xl font-extrabold text-[#081c44]">
              Estado de tu Loop
            </h2>

            <p class="mt-2 text-sm font-semibold text-slate-500">
              Confirmá la asistencia después de la clase para cerrar el intercambio.
            </p>
          </div>

          <div id="sinReserva" class="hidden rounded-2xl bg-slate-50 p-8 text-center">
            <p class="text-sm font-bold text-slate-500">
              Todavía no tenés clases reservadas.
            </p>

            <a
              href="/profesores"
              class="mt-5 inline-block rounded-full bg-[#0047ff] px-6 py-3 text-[10px] font-bold uppercase text-white transition hover:bg-blue-700"
            >
              Buscar profesor
            </a>
          </div>

          <div id="cardReserva" class="hidden">
            <div class="mb-6 rounded-2xl bg-slate-50 p-6">
              <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
                <div>
                  <p class="text-xs font-bold uppercase tracking-widest text-[#0047ff]">
                Clase pendiente
                  </p>

                  <h3 id="tituloReserva" class="mt-2 text-2xl font-extrabold text-[#081c44]">
                  </h3>

                  <p id="detalleReserva" class="mt-2 text-sm font-semibold text-slate-600">
                  </p>
                </div>

                <span
                  id="estadoReserva"
                  class="w-fit rounded-full bg-yellow-100 px-4 py-2 text-[10px] font-bold uppercase text-yellow-700"
                >
                  Pendiente
                </span>
              </div>
            </div>

            <div class="mb-6 rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
              <p class="mb-2 text-sm font-bold text-[#081c44]">
                Link externo de la clase
              </p>

              <a
                id="linkMeet"
                href="#"
                target="_blank"
                class="text-sm font-bold text-[#0047ff] underline"
              >
                Abrir Google Meet
              </a>
            </div>

            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
              <button
                id="btnCheckAlumno"
                class="rounded-full border border-[#0047ff] px-6 py-3 text-[10px] font-bold uppercase text-[#0047ff] transition hover:bg-[#0047ff] hover:text-white"
              >
                Check-in alumno
              </button>

              <button
                id="btnCheckProfesor"
                class="rounded-full border border-[#0047ff] px-6 py-3 text-[10px] font-bold uppercase text-[#0047ff] transition hover:bg-[#0047ff] hover:text-white"
              >
                Check-in profesor
              </button>
            </div>

            <div id="accionesFinales" class="mt-6 hidden rounded-2xl bg-green-50 p-5">
              <p class="mb-4 text-sm font-bold text-green-700">
                Validación dual completada. El Loop fue confirmado.
              </p>

              <a
                id="linkCalificar"
                href="/califica"
                class="inline-block rounded-full bg-[#0047ff] px-6 py-3 text-[10px] font-bold uppercase text-white transition hover:bg-blue-700"
              >
                Calificar clase
              </a>
            </div>

            <button
              id="btnAyuda"
              class="mt-6 text-[10px] font-bold uppercase text-red-500 underline"
            >
              ¿Tu alumno/profesor no se presentó?
            </button>

            <p
              id="mensajeAyuda"
              class="mt-4 hidden rounded-xl bg-red-50 px-4 py-3 text-sm font-semibold text-red-600"
            >
              Reporte enviado a soporte. El turno quedó en conflicto.
            </p>

            <button
              id="btnResolverConflicto"
              class="mt-4 hidden rounded-full bg-red-600 px-6 py-3 text-[10px] font-bold uppercase text-white transition hover:bg-red-700 disabled:cursor-not-allowed disabled:opacity-60"
            >
              Cancelar y recuperar token
            </button>
          </div>
        </section>
      </div>
    </section>
  </main>

  <script>
    const API_URL = ["localhost", "127.0.0.1"].includes(window.location.hostname)
      ? "http://127.0.0.1:5000"
      : "https://loop-backend-b1g8.onrender.com";
    const token = localStorage.getItem("token");

    if (!token) {
      window.location.href = "/login";
    }

    const listaMensajes = document.getElementById("listaMensajes") as HTMLDivElement | null;
    const sinReserva = document.getElementById("sinReserva") as HTMLDivElement | null;
    const cardReserva = document.getElementById("cardReserva") as HTMLDivElement | null;

    const tituloReserva = document.getElementById("tituloReserva") as HTMLHeadingElement | null;
    const detalleReserva = document.getElementById("detalleReserva") as HTMLParagraphElement | null;
    const estadoReserva = document.getElementById("estadoReserva") as HTMLSpanElement | null;
    const linkMeet = document.getElementById("linkMeet") as HTMLAnchorElement | null;

    const btnCheckAlumno = document.getElementById("btnCheckAlumno") as HTMLButtonElement | null;
    const btnCheckProfesor = document.getElementById("btnCheckProfesor") as HTMLButtonElement | null;
    const accionesFinales = document.getElementById("accionesFinales") as HTMLDivElement | null;
    const linkCalificar = document.getElementById("linkCalificar") as HTMLAnchorElement | null;

    const btnAyuda = document.getElementById("btnAyuda") as HTMLButtonElement | null;
    const btnResolverConflicto = document.getElementById("btnResolverConflicto") as HTMLButtonElement | null;
    const mensajeAyuda = document.getElementById("mensajeAyuda") as HTMLParagraphElement | null;

    let reservaActual: any = null;

    function claseNotificacion(tipo: string) {
      if (tipo === "conflicto") return "border-red-500";
      if (tipo === "validacion") return "border-green-500";
      if (tipo === "calificacion") return "border-green-500";
      if (tipo === "cancelacion") return "border-slate-500";
      if (tipo === "postulacion") return "border-purple-500";
      if (tipo === "mensaje") return "border-cyan-500";
      return "border-[#0047ff]";
    }

    function pintarNotificaciones(notificaciones: any[]) {
      if (!listaMensajes || notificaciones.length === 0) return false;

      listaMensajes.innerHTML = notificaciones.map((notificacion) => `
        <div class="rounded-2xl border-l-4 ${claseNotificacion(notificacion.type)} bg-slate-50 p-4">
          <p class="text-sm font-bold text-[#081c44]">
            ${notificacion.title}
          </p>
          <p class="mt-1 text-xs font-semibold text-slate-500">
            ${notificacion.body || "Sin detalle adicional."}
          </p>
        </div>
      `).join("");

      return true;
    }

    async function cargarNotificaciones() {
      try {
        const respuesta = await fetch(`${API_URL}/api/notificaciones`, {
          headers: {
            Authorization: `Bearer ${token}`,
          },
        });

        const data = await respuesta.json();

        if (!respuesta.ok) return false;

        return pintarNotificaciones(data.notificaciones ?? []);
      } catch (error) {
        console.error("No se pudieron cargar las notificaciones", error);
        return false;
      }
    }

    function pintarSinReserva() {
      sinReserva?.classList.remove("hidden");
      cardReserva?.classList.add("hidden");

      if (listaMensajes) {
        listaMensajes.innerHTML = `
          <div class="rounded-2xl bg-slate-50 p-4">
            <p class="text-sm font-bold text-slate-500">
              No tenés notificaciones nuevas.
            </p>
          </div>
        `;
      }

      cargarNotificaciones();
    }

    function pintarMensajes(reserva: any) {
      if (!listaMensajes) return;

      listaMensajes.innerHTML = `
        <div class="rounded-2xl border-l-4 border-red-500 bg-slate-50 p-4">
          <p class="text-sm font-bold text-[#081c44]">
            Intercambiaste 1 token por una clase con ${reserva.profesorNombre}.
          </p>
          <p class="mt-1 text-xs font-semibold text-slate-500">
            Turno: ${reserva.turno}
          </p>
        </div>

        <div class="rounded-2xl border-l-4 border-[#0047ff] bg-slate-50 p-4">
          <p class="text-sm font-bold text-[#081c44]">
            El link de Meet ya está disponible.
          </p>
          <p class="mt-1 text-xs font-semibold text-slate-500">
            Ingresá desde el detalle de tu Loop.
          </p>
        </div>

        <div class="rounded-2xl border-l-4 border-yellow-500 bg-slate-50 p-4">
          <p class="text-sm font-bold text-[#081c44]">
            Después de la clase, recordá hacer el check-in.
          </p>
        </div>
      `;
    }

    function pintarReserva(reserva: any) {
      reservaActual = reserva;

      sinReserva?.classList.add("hidden");
      cardReserva?.classList.remove("hidden");
      pintarMensajes(reserva);
      cargarNotificaciones();

      if (tituloReserva) {
        tituloReserva.textContent = reserva.rolEnReserva === "profesor"
          ? `Clase para dictar: ${reserva.profesorNombre}`
          : `Clase con ${reserva.profesorNombre}`;
      }

      const etiquetaReserva = cardReserva?.querySelector("p.text-xs");
      if (etiquetaReserva) {
        etiquetaReserva.textContent =
          reserva.estado === "COMPLETADA" ? "Clase lista para calificar" : "Clase pendiente";
      }

      if (detalleReserva) {
        detalleReserva.textContent = `Turno seleccionado: ${reserva.turno}`;
      }

      if (linkMeet) {
        linkMeet.href = reserva.meet;
      }

      actualizarEstado(reserva);
    }

    function actualizarEstado(reserva: any) {
      if (!estadoReserva || !accionesFinales || !btnCheckAlumno || !btnCheckProfesor) return;

      if (reserva.estado === "EN_CONFLICTO") {
        estadoReserva.textContent = "En conflicto";
        estadoReserva.className =
          "w-fit rounded-full bg-red-100 px-4 py-2 text-[10px] font-bold uppercase text-red-700";

        btnCheckAlumno.disabled = true;
        btnCheckProfesor.disabled = true;
        btnCheckAlumno.className =
          "rounded-full bg-slate-100 px-6 py-3 text-[10px] font-bold uppercase text-slate-400";
        btnCheckProfesor.className =
          "rounded-full bg-slate-100 px-6 py-3 text-[10px] font-bold uppercase text-slate-400";
        accionesFinales.classList.add("hidden");

        if (mensajeAyuda) {
          mensajeAyuda.textContent = reserva.reporteConflicto || "Reporte enviado a soporte. El turno quedó en conflicto.";
          mensajeAyuda.classList.remove("hidden");
        }

        btnAyuda?.classList.add("hidden");
        btnResolverConflicto?.classList.remove("hidden");

        return;
      }

      btnAyuda?.classList.remove("hidden");
      btnResolverConflicto?.classList.add("hidden");

      const checkAlumno = Boolean(reserva.checkAlumno);
      const checkProfesor = Boolean(reserva.checkProfesor);

      btnCheckAlumno.textContent = checkAlumno ? "Alumno confirmado" : "Check-in alumno";
      btnCheckAlumno.disabled = checkAlumno;
      btnCheckAlumno.className = checkAlumno
        ? "rounded-full bg-green-100 px-6 py-3 text-[10px] font-bold uppercase text-green-700"
        : "rounded-full border border-[#0047ff] px-6 py-3 text-[10px] font-bold uppercase text-[#0047ff] transition hover:bg-[#0047ff] hover:text-white";

      btnCheckProfesor.textContent = checkProfesor ? "Profesor confirmado" : "Check-in profesor";
      btnCheckProfesor.disabled = checkProfesor;
      btnCheckProfesor.className = checkProfesor
        ? "rounded-full bg-green-100 px-6 py-3 text-[10px] font-bold uppercase text-green-700"
        : "rounded-full border border-[#0047ff] px-6 py-3 text-[10px] font-bold uppercase text-[#0047ff] transition hover:bg-[#0047ff] hover:text-white";

      const profesorDemo = Number(reserva.profesorId) >= 1000;

      if (reserva.rolEnReserva === "alumno" && !profesorDemo && !checkProfesor) {
        btnCheckProfesor.textContent = "Lo confirma el profesor";
        btnCheckProfesor.disabled = true;
        btnCheckProfesor.className =
          "rounded-full bg-slate-100 px-6 py-3 text-[10px] font-bold uppercase text-slate-400";
      }

      if (reserva.rolEnReserva === "profesor" && !checkAlumno) {
        btnCheckAlumno.textContent = "Lo confirma el alumno";
        btnCheckAlumno.disabled = true;
        btnCheckAlumno.className =
          "rounded-full bg-slate-100 px-6 py-3 text-[10px] font-bold uppercase text-slate-400";
      }

      if (checkAlumno && checkProfesor) {
        estadoReserva.textContent = "Confirmado";
        estadoReserva.className =
          "w-fit rounded-full bg-green-100 px-4 py-2 text-[10px] font-bold uppercase text-green-700";
        accionesFinales.classList.remove("hidden");
        if (linkCalificar) {
          linkCalificar.style.display = reserva.rolEnReserva === "profesor" ? "none" : "inline-block";
        }
        btnAyuda?.classList.add("hidden");
      } else {
        estadoReserva.textContent = "Pendiente";
        estadoReserva.className =
          "w-fit rounded-full bg-yellow-100 px-4 py-2 text-[10px] font-bold uppercase text-yellow-700";
        accionesFinales.classList.add("hidden");
        btnAyuda?.classList.remove("hidden");
      }
    }

    async function cargarReservaActiva() {
      try {
        const respuesta = await fetch(`${API_URL}/api/reservas/activa`, {
          headers: {
            Authorization: `Bearer ${token}`,
          },
        });

        const data = await respuesta.json();

        if (!respuesta.ok || !data.reserva) {
          pintarSinReserva();
          return;
        }

        pintarReserva(data.reserva);
      } catch (error) {
        pintarSinReserva();
      }
    }

    async function confirmar(tipo: "alumno" | "profesor") {
      if (!reservaActual) return;

      const boton = tipo === "alumno" ? btnCheckAlumno : btnCheckProfesor;
      const accion = tipo === "alumno" ? "confirmar-alumno" : "confirmar-profesor";

      if (boton) {
        boton.disabled = true;
        boton.textContent = "Confirmando...";
      }

      try {
        const respuesta = await fetch(`${API_URL}/api/reservas/${reservaActual.id}/${accion}`, {
          method: "PATCH",
          headers: {
            Authorization: `Bearer ${token}`,
          },
        });

        const data = await respuesta.json();

        if (!respuesta.ok) {
          alert(data.mensaje || "No se pudo confirmar la asistencia.");
          actualizarEstado(reservaActual);
          return;
        }

        pintarReserva(data.reserva);
      } catch (error) {
        alert("No se pudo conectar con el servidor. Verificá que Flask esté ejecutándose.");
        actualizarEstado(reservaActual);
      }
    }

    btnCheckAlumno?.addEventListener("click", () => confirmar("alumno"));
    btnCheckProfesor?.addEventListener("click", () => confirmar("profesor"));

    btnAyuda?.addEventListener("click", async () => {
      if (!reservaActual || !mensajeAyuda || !btnAyuda) return;

      btnAyuda.disabled = true;
      btnAyuda.textContent = "Enviando reporte...";

      try {
        const respuesta = await fetch(`${API_URL}/api/reservas/${reservaActual.id}/conflicto`, {
          method: "PATCH",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${token}`,
          },
          body: JSON.stringify({
            motivo: "El alumno o profesor no se presentó a la clase.",
          }),
        });

        const data = await respuesta.json();

        if (!respuesta.ok) {
          alert(data.mensaje || "No se pudo enviar el reporte.");
          return;
        }

        pintarReserva(data.reserva);
      } catch (error) {
        alert("No se pudo conectar con el servidor. Verificá que Flask esté ejecutándose.");
      } finally {
        btnAyuda.disabled = false;
        btnAyuda.textContent = "¿Tu alumno/profesor no se presentó?";
      }
    });

    btnResolverConflicto?.addEventListener("click", async () => {
      if (!reservaActual || !btnResolverConflicto) return;

      btnResolverConflicto.disabled = true;
      btnResolverConflicto.textContent = "Cancelando...";

      try {
        const respuesta = await fetch(`${API_URL}/api/reservas/${reservaActual.id}/cancelar`, {
          method: "PATCH",
          headers: {
            Authorization: `Bearer ${token}`,
          },
        });

        const data = await respuesta.json();

        if (!respuesta.ok) {
          alert(data.mensaje || "No se pudo cancelar la reserva.");
          return;
        }

        const usuarioGuardado = localStorage.getItem("usuario");
        if (usuarioGuardado && data.tokens !== null && data.tokens !== undefined) {
          const usuario = JSON.parse(usuarioGuardado);
          usuario.tokens = data.tokens;
          localStorage.setItem("usuario", JSON.stringify(usuario));

          const navTokens = document.getElementById("navTokens");
          if (navTokens) {
            navTokens.textContent = String(data.tokens);
          }
        }

        alert("Reserva cancelada. Se recuperó el token.");
        reservaActual = null;
        pintarSinReserva();
      } catch (error) {
        alert("No se pudo conectar con el servidor. Verificá que Flask esté ejecutándose.");
      } finally {
        btnResolverConflicto.disabled = false;
        btnResolverConflicto.textContent = "Cancelar y recuperar token";
      }
    });

    cargarReservaActiva();
  </script>
</Layout>
