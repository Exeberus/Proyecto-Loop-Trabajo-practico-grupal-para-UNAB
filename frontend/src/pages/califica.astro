---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Loop - Calificar Clase" usuarioLogueado={true}>
  <div class="w-full min-h-[calc(100vh-100px)] flex flex-col items-center justify-center px-6 relative">
    
    <div class="absolute top-10 left-1/4 w-96 h-96 bg-blue-800 rounded-full blur-3xl opacity-20 -z-10"></div>
    <div class="absolute top-20 left-1/3 w-80 h-80 bg-teal-400 rounded-full blur-3xl opacity-20 -z-10"></div>

    <div class="w-full max-w-4xl bg-white rounded-[3rem] p-12 md:p-20 shadow-2xl border border-gray-50 text-center relative z-10">
      
      <h1 class="text-4xl md:text-5xl font-bold text-blue-600 tracking-tight mb-8">
        ¿Cómo fue tu clase de hoy?
      </h1>
      
      <div id="contenedor-estrellas" class="flex justify-center gap-3 mb-10 text-blue-600 cursor-pointer">
        {[1, 2, 3, 4, 5].map((num) => (
          <svg data-valor={num} class="estrella w-10 h-10 transition-colors duration-200" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
          </svg>
        ))}
      </div>

      <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest mb-4">¿No se presentó? Comunicate con nosotros.</p>
      
      <button id="btnAyuda" class="bg-blue-600 text-white font-bold text-[10px] px-10 py-3 rounded-full hover:bg-blue-700 transition uppercase tracking-widest shadow-md">
        AYUDA
      </button>

    </div>

    <div class="w-full max-w-4xl mt-6 text-left relative z-10">
      <a href="/perfil" class="text-blue-600 font-bold text-[10px] uppercase hover:underline tracking-widest">&lt; VOLVER</a>
    </div>

  </div>

  <script is:inline>
    const inicializarEstrellas = () => {
      const estrellas = document.querySelectorAll('.estrella');
      let calificacionActual = 0;

      // Función para pintar las estrellas
      const pintarEstrellas = (valor) => {
        estrellas.forEach(estrella => {
          const valorEstrella = parseInt(estrella.getAttribute('data-valor'));
          if (valorEstrella <= valor) {
            estrella.setAttribute('fill', 'currentColor'); // Llena
          } else {
            estrella.setAttribute('fill', 'none'); // Vacía
          }
        });
      };

      // Eventos para cada estrella
      estrellas.forEach(estrella => {
        // Al pasar el mouse, pintamos temporalmente
        estrella.addEventListener('mouseover', (e) => {
          pintarEstrellas(parseInt(e.currentTarget.getAttribute('data-valor')));
        });

        // Al sacar el mouse, volvemos a la calificación guardada
        estrella.addEventListener('mouseout', () => {
          pintarEstrellas(calificacionActual);
        });

        // Al hacer clic, guardamos el valor y mandamos al backend
        estrella.addEventListener('click', async (e) => {
          calificacionActual = parseInt(e.currentTarget.getAttribute('data-valor'));
          pintarEstrellas(calificacionActual);
          
          // ESTRUCTURA COMPATIBLE CON EL BACKEND
          console.log(`Enviando ${calificacionActual} estrellas al servidor...`);
          /*
          try {
            const respuesta = await fetch('http://127.0.0.1:5000/api/puntuar_clase', {
              method: 'POST',
              headers: { 
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${localStorage.getItem('token')}`
              },
              body: JSON.stringify({ estrellas: calificacionActual })
            });
            if(respuesta.ok) {
               alert("¡Gracias por tu feedback!");
               window.location.href = '/perfil';
            }
          } catch (error) {
            console.error("Error al calificar:", error);
          }
          */
        });
      });
    };

    inicializarEstrellas();
    document.addEventListener('astro:page-load', inicializarEstrellas);
  </script>
</Layout>