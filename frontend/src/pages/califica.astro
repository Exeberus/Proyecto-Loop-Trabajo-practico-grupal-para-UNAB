---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Calificar clase" usuarioLogueado={true}>
  <main class="relative min-h-[calc(100vh-160px)] overflow-hidden bg-[#f5f5f5] px-5 py-12">
    <!-- Decoración similar al wireframe -->
    <div class="absolute left-[22%] top-4 z-0 h-64 w-64 rounded-full bg-[#0047ff]"></div>
    <div class="absolute left-[34%] top-20 z-0 h-56 w-56 rounded-full bg-teal-300"></div>

    <section class="relative z-10 mx-auto max-w-6xl">
      <article class="rounded-[28px] bg-white px-6 py-10 text-center shadow-xl md:px-12">
        <h1 class="mb-4 text-3xl font-extrabold text-[#0047ff] md:text-4xl">
          ¿Cómo fue tu clase de hoy?
        </h1>

        <p id="textoReserva" class="mb-5 text-xs font-bold text-slate-400">
          ¿Ya se pudo intercambiar conocimiento?
        </p>

        <form id="formCalificacion" class="mx-auto max-w-xl">
          <!-- Estrellas -->
          <div class="mb-4 flex justify-center gap-1">
            <button
              type="button"
              class="estrella text-4xl text-slate-300 transition hover:scale-110"
              data-value="1"
              aria-label="Calificar con 1 estrella"
            >
              ★
            </button>

            <button
              type="button"
              class="estrella text-4xl text-slate-300 transition hover:scale-110"
              data-value="2"
              aria-label="Calificar con 2 estrellas"
            >
              ★
            </button>

            <button
              type="button"
              class="estrella text-4xl text-slate-300 transition hover:scale-110"
              data-value="3"
              aria-label="Calificar con 3 estrellas"
            >
              ★
            </button>

            <button
              type="button"
              class="estrella text-4xl text-slate-300 transition hover:scale-110"
              data-value="4"
              aria-label="Calificar con 4 estrellas"
            >
              ★
            </button>

            <button
              type="button"
              class="estrella text-4xl text-slate-300 transition hover:scale-110"
              data-value="5"
              aria-label="Calificar con 5 estrellas"
            >
              ★
            </button>
          </div>

          <input id="rating" name="rating" type="hidden" value="0" />

          <p
            id="resumenRating"
            class="mb-4 hidden text-sm font-bold text-[#0047ff]"
          >
          </p>

          <textarea
            id="comentario"
            name="comentario"
            rows="3"
            placeholder="Dejá un comentario sobre la clase..."
            class="mx-auto mb-4 block w-full resize-none rounded-2xl border border-slate-200 bg-slate-50 px-5 py-4 text-sm outline-none transition focus:ring-2 focus:ring-[#0047ff]"
          ></textarea>

          <p
            id="mensajeCalificacion"
            class="mb-5 hidden rounded-xl px-4 py-3 text-sm font-semibold"
          >
          </p>

          <button
            id="btnEnviarCalificacion"
            type="submit"
            class="rounded-full bg-[#0047ff] px-9 py-3 text-[10px] font-bold uppercase text-white shadow-md transition hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-60"
          >
            Enviar
          </button>

          <div class="mt-6">
            <p class="text-xs font-bold text-slate-400">
              ¿No se presentó? Comunicate con nosotros.
            </p>
            <a
              href="mailto:loop.unab@gmail.com"
              class="mt-3 inline-block rounded-full bg-[#0047ff] px-7 py-3 text-[10px] font-bold uppercase text-white transition hover:bg-blue-700"
            >
              Ayuda
            </a>
          </div>
        </form>
      </article>

      <a
        href="/mensajes"
        class="mt-7 inline-block text-[10px] font-bold uppercase text-[#0047ff] underline"
      >
        &lt; Volver
      </a>
    </section>
  </main>

  <script>
    const API_URL = ["localhost", "127.0.0.1"].includes(window.location.hostname)
      ? "http://127.0.0.1:5000"
      : "https://loop-backend-b1g8.onrender.com";
    const token = localStorage.getItem("token");

    if (!token) {
      window.location.href = "/login";
    }

    const textoReserva = document.getElementById("textoReserva") as HTMLParagraphElement | null;
    const formCalificacion = document.getElementById("formCalificacion") as HTMLFormElement | null;
    const inputRating = document.getElementById("rating") as HTMLInputElement | null;
    const resumenRating = document.getElementById("resumenRating") as HTMLParagraphElement | null;
    const comentario = document.getElementById("comentario") as HTMLTextAreaElement | null;
    const mensajeCalificacion = document.getElementById("mensajeCalificacion") as HTMLParagraphElement | null;
    const btnEnviarCalificacion = document.getElementById("btnEnviarCalificacion") as HTMLButtonElement | null;

    const estrellas = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".estrella")
    );

    let ratingSeleccionado = 0;
    let reservaActual: any = null;

    async function cargarReservaParaCalificar() {
      try {
        const respuesta = await fetch(`${API_URL}/api/reservas/para-calificar`, {
          headers: {
            Authorization: `Bearer ${token}`,
          },
        });

        const data = await respuesta.json();

        if (!respuesta.ok || !data.reserva) {
          mostrarMensaje("No encontramos una clase pendiente para calificar. Volvé a notificaciones para revisar tu Loop.", "error");
          btnEnviarCalificacion?.setAttribute("disabled", "true");
          return;
        }

        reservaActual = data.reserva;

        if (textoReserva) {
          textoReserva.textContent = `Profesor: ${reservaActual.targetUserName} - ${reservaActual.turno}`;
        }

        if (!["COMPLETADA", "CALIFICADA"].includes(reservaActual.estado)) {
          mostrarMensaje("Primero hay que completar el check-in de alumno y profesor desde Notificaciones.", "error");
          btnEnviarCalificacion?.setAttribute("disabled", "true");
          return;
        }

        btnEnviarCalificacion?.removeAttribute("disabled");
      } catch (error) {
        mostrarMensaje("No se pudo conectar con el servidor. Verificá que Flask esté ejecutándose.", "error");
        btnEnviarCalificacion?.setAttribute("disabled", "true");
      }
    }

    function mostrarMensaje(texto: string, tipo: "error" | "ok") {
      if (!mensajeCalificacion) return;

      mensajeCalificacion.textContent = texto;
      mensajeCalificacion.classList.remove("hidden");

      if (tipo === "error") {
        mensajeCalificacion.className =
          "mb-5 rounded-xl bg-red-50 px-4 py-3 text-sm font-semibold text-red-600";
      }

      if (tipo === "ok") {
        mensajeCalificacion.className =
          "mb-5 rounded-xl bg-green-50 px-4 py-3 text-sm font-semibold text-green-600";
      }
    }

    function pintarEstrellas(rating: number) {
      estrellas.forEach((estrella) => {
        const valor = Number(estrella.dataset.value);

        if (valor <= rating) {
          estrella.classList.remove("text-slate-300");
          estrella.classList.add("text-[#0047ff]");
        } else {
          estrella.classList.remove("text-[#0047ff]");
          estrella.classList.add("text-slate-300");
        }
      });
    }

    estrellas.forEach((estrella) => {
      estrella.addEventListener("click", () => {
        ratingSeleccionado = Number(estrella.dataset.value);

        if (inputRating) {
          inputRating.value = String(ratingSeleccionado);
        }

        if (resumenRating) {
          resumenRating.textContent =
            ratingSeleccionado === 1
              ? "Seleccionaste 1 estrella"
              : `Seleccionaste ${ratingSeleccionado} estrellas`;
          resumenRating.classList.remove("hidden");
        }

        pintarEstrellas(ratingSeleccionado);
      });
    });

    formCalificacion?.addEventListener("submit", async (evento) => {
      evento.preventDefault();

      if (ratingSeleccionado === 0) {
        mostrarMensaje("Seleccioná una calificación de 1 a 5 estrellas.", "error");
        return;
      }

      if (!reservaActual?.targetUserId) {
        mostrarMensaje("No encontramos la reserva asociada a esta calificación.", "error");
        return;
      }

      if (btnEnviarCalificacion) {
        btnEnviarCalificacion.disabled = true;
        btnEnviarCalificacion.textContent = "Enviando...";
      }

      try {
        const respuesta = await fetch(`${API_URL}/api/ratings/reserva`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${token}`,
          },
          body: JSON.stringify({
            rated_user_id: reservaActual.targetUserId,
            reserva_id: reservaActual.id,
            stars: ratingSeleccionado,
            comment: comentario?.value ?? "",
          }),
        });

        const data = await respuesta.json();

        if (!respuesta.ok) {
          mostrarMensaje(data.mensaje || "No se pudo guardar la calificación.", "error");
          return;
        }

        mostrarMensaje("Calificación enviada correctamente. Gracias por cerrar el Loop.", "ok");

        setTimeout(() => {
          window.location.href = "/perfil";
        }, 1200);
      } catch (error) {
        mostrarMensaje(
          "No se pudo conectar con el servidor. Verificá que Flask esté ejecutándose.",
          "error"
        );
      } finally {
        if (btnEnviarCalificacion) {
          btnEnviarCalificacion.disabled = false;
          btnEnviarCalificacion.textContent = "Enviar";
        }
      }
    });

    cargarReservaParaCalificar();
  </script>
</Layout>
