---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Iniciar sesión">
  <main class="flex min-h-[calc(100vh-160px)] items-center justify-center bg-slate-50 px-5 py-12">
    <section class="w-full max-w-md rounded-[32px] border border-slate-100 bg-white p-8 shadow-xl md:p-10">
      
      <div class="mb-8 text-center">
        <h1 class="mb-2 text-3xl font-extrabold text-[#0047ff]">
          ¡Hola de nuevo!
        </h1>

        <p class="text-sm font-medium text-slate-500">
          Ingresá tus datos para seguir aprendiendo.
        </p>
      </div>

      <form id="formLogin" class="flex flex-col gap-5">
        <div>
          <label
            for="email"
            class="mb-2 block text-xs font-bold uppercase tracking-widest text-[#081c44]"
          >
            Email
          </label>

          <input
            type="email"
            id="email"
            name="email"
            placeholder="tumail@ejemplo.com"
            autocomplete="email"
            required
            class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-800 outline-none transition focus:border-[#0047ff] focus:ring-2 focus:ring-blue-100"
          />
        </div>

        <div>
          <div class="mb-2 flex items-center justify-between gap-3">
            <label
              for="password"
              class="block text-xs font-bold uppercase tracking-widest text-[#081c44]"
            >
              Contraseña
            </label>

            <a
              href="/recuperacion"
              class="text-[10px] font-bold uppercase tracking-wider text-[#0047ff] hover:underline"
            >
              ¿Te olvidaste?
            </a>
          </div>

          <input
            type="password"
            id="password"
            name="password"
            placeholder="••••••••"
            autocomplete="current-password"
            required
            class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-800 outline-none transition focus:border-[#0047ff] focus:ring-2 focus:ring-blue-100"
          />
        </div>

        <p
          id="mensajeLogin"
          class="hidden rounded-xl px-4 py-3 text-sm font-semibold"
        >
        </p>

        <button
          id="btnLogin"
          type="submit"
          class="mt-3 w-full rounded-full bg-[#0047ff] px-8 py-4 text-xs font-bold uppercase tracking-widest text-white shadow-md transition hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-60"
        >
          Ingresar
        </button>
      </form>

      <div class="mt-8 text-center">
        <p class="text-sm font-medium text-slate-500">
          ¿No tenés cuenta?
          <a href="/register" class="ml-1 font-bold text-[#0047ff] hover:underline">
            Registrate acá
          </a>
        </p>
      </div>
    </section>
  </main>

 <script>
  const API_URL = "http://localhost:5000";

  const formLogin = document.getElementById("formLogin") as HTMLFormElement | null;
  const mensajeLogin = document.getElementById("mensajeLogin") as HTMLParagraphElement | null;
  const btnLogin = document.getElementById("btnLogin") as HTMLButtonElement | null;

  type TipoMensaje = "error" | "ok";

  function mostrarMensaje(texto: string, tipo: TipoMensaje) {
    if (!mensajeLogin) return;

    mensajeLogin.textContent = texto;
    mensajeLogin.classList.remove("hidden");

    if (tipo === "error") {
      mensajeLogin.className =
        "rounded-xl bg-red-50 px-4 py-3 text-sm font-semibold text-red-600";
    }

    if (tipo === "ok") {
      mensajeLogin.className =
        "rounded-xl bg-green-50 px-4 py-3 text-sm font-semibold text-green-600";
    }
  }

  if (formLogin && btnLogin) {
    formLogin.addEventListener("submit", async (e) => {
      e.preventDefault();

      const formData = new FormData(formLogin);

      const datosLogin = {
        email: String(formData.get("email") ?? ""),
        password: String(formData.get("password") ?? ""),
      };

      try {
        btnLogin.disabled = true;
        btnLogin.textContent = "Ingresando...";

        const respuesta = await fetch(`${API_URL}/api/login`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(datosLogin),
        });

        const data = await respuesta.json();

        if (!respuesta.ok) {
          mostrarMensaje(data.mensaje || "Email o contraseña incorrectos.", "error");
          return;
        }

        localStorage.setItem("usuario", JSON.stringify(data.usuario));
        localStorage.setItem("token", data.token);

        mostrarMensaje("Inicio de sesión correcto. Redirigiendo...", "ok");

        setTimeout(() => {
          window.location.href = "/perfil";
        }, 800);
      } catch (error) {
        mostrarMensaje(
          "No se pudo conectar con el servidor. Verificá que Flask esté ejecutándose.",
          "error"
        );
      } finally {
        btnLogin.disabled = false;
        btnLogin.textContent = "Ingresar";
      }
    });
  }
</script>
</Layout>