---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

// 1. Acá agregamos la variable "usuarioLogueado" (por defecto en false)
const { title, usuarioLogueado = false } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png?v=2" />
    <link rel="shortcut icon" type="image/png" href="/favicon.png?v=2" />
    <link rel="apple-touch-icon" href="/favicon.png?v=2" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Loop</title>
  </head>
  <body class="bg-[#f5f5f5] text-slate-900 min-h-screen flex flex-col font-sans m-0 p-0">
    
    <Navbar usuarioLogueado={usuarioLogueado} />
    
    <div class="flex-1">
      <slot />
    </div>
    
    <Footer />
    
  </body>
</html>
