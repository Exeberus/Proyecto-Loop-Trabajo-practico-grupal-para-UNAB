---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

// 1. Acá agregamos la variable "usuarioLogueado" (por defecto en false)
const { title, usuarioLogueado = false } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="../public/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Loop</title>
  </head>
  <body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col justify-between font-sans m-0 p-0">
    
    <Navbar usuarioLogueado={usuarioLogueado} />
    
    <slot />
    
    <Footer />
    
  </body>
</html>